{
  "name": "mebee",
  "private": true,
  "type": "module",
  "description": "Procedural WebGPU macro flower. The app itself has no build step and no runtime dependencies; these are verification tools only.",
  "scripts": {
    "check": "npm run check:validate && npm run check:bindings && npm run check:flight",
    "check:parse": "node tools/check-shaders.mjs",
    "check:validate": "node tools/validate-shaders.mjs",
    "check:bindings": "node tools/check-bindings.mjs",
    "check:flight": "node tools/check-flight.mjs",
    "preview:leaf": "node tools/preview-leaf.mjs /tmp/leaf.png 640",
    "preview:flower": "node tools/preview-flower.mjs /tmp/flower.png 720 three-quarter",
    "preview:sky": "node tools/preview-sky.mjs /tmp/sky.png",
    "serve": "http-server . -p 8080"
  },
  "devDependencies": {
    "naga-wasi-cli": "^0.1.0",
    "wgsl_reflect": "^1.5.0"
  }
}
