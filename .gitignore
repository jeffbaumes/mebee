# Without a trailing slash, so this also catches the symlink a container
# setup may leave here: `node_modules/` matches a directory only, which is
# how a symlink to one session's scratchpad ended up committed.
node_modules
# Generated by `npm install`. The two devDependencies are verification tools
# and the app itself has no runtime dependencies, so there is nothing here
# worth pinning.
package-lock.json
